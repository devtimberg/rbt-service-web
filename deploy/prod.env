# rbt74-service-web — prod (https://rbt74.ru)

# Имя compose-проекта и каталога в /opt/rbt74/apps
STACK_NAME=rbt74-service-web-prod
# Белый список домена: PROD_SITE_ALLOWED_IPS (rbt74.ru: сайт и /api) в stacks/traefik/.env инфраструктуры
ACCESS_MIDDLEWARE=prod-site-allowlist@docker

APP_HOST=rbt74.ru
TZ=Europe/Moscow

# SSR-запросы к API идут внутри сети rbt74-proxy, мимо Traefik:
# core-service-prod — алиас бэкенда prod (API_ALIAS в rbt74-core-service/deploy/prod.env), /api — context-path
API_INTERNAL_URL=http://core-service-prod:8080/api

# Публичный адрес сайта для SEO (canonical, og:url, robots.txt, sitemap.xml); читается в рантайме
SITE_URL=https://rbt74.ru
