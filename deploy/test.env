# rbt74-service-web — тестовый стенд test.rbt74.ru

# Имя compose-проекта и каталога в /opt/rbt74/apps
STACK_NAME=rbt74-service-web
# Белый список домена: TEST_ALLOWED_IPS в stacks/traefik/.env инфраструктуры
ACCESS_MIDDLEWARE=test-allowlist@docker

APP_HOST=test.rbt74.ru
TZ=Europe/Moscow

# SSR-запросы к API идут внутри сети rbt74-proxy, мимо Traefik:
# core-service-test — алиас бэкенда test (API_ALIAS в rbt74-core-service/deploy/test.env), /api — context-path
API_INTERNAL_URL=http://core-service-test:8080/api

# Публичный адрес сайта для SEO (canonical, og:url, robots.txt, sitemap.xml); читается в рантайме
SITE_URL=https://test.rbt74.ru
