# Скопируйте в .env и подставьте значения. .env в git не попадает.

# --- Серверные переменные (читаются в рантайме, в браузер не попадают) ---

# Адрес API rbt-service-api для SSR-запросов (внутренняя сеть / сервис в docker-сети)
API_INTERNAL_URL=http://localhost:8001

# Секрет подписи cookie-сессии, не короче 32 символов. Сгенерировать: openssl rand -base64 32
SESSION_SECRET=

# Доверять X-Forwarded-For / X-Real-IP клиента при определении его IP (true/false, по умолчанию false).
# ЗА РЕВЕРС-ПРОКСИ ОБЯЗАТЕЛЬНО true: иначе API видит IP прокси у всех пользователей, и его лимит
# 20 OTP-писем/час на IP становится общим на весь сайт. Прокси должен ПЕРЕЗАПИСЫВАТЬ X-Forwarded-For/X-Real-IP,
# а приложение и API не должны быть доступны в обход прокси. Без прокси оставьте false (иначе IP можно подделать).
TRUST_PROXY=false

# --- Публичные переменные (VITE_*, вшиваются в бандл при сборке) ---
# Пока не требуются.
