# Скопируйте в .env и подставьте значения. .env в git не попадает.

# --- Серверные переменные (читаются в рантайме, в браузер не попадают) ---

# Базовый адрес API с префиксом /api (для Route Handlers и SSR-запросов).
# Прокси перед Next.js обязан перезаписывать X-Real-IP реальным IP клиента.
API_INTERNAL_URL=https://test.rbt74.ru/api

# Публичный адрес сайта для SEO-тегов (canonical, og:url, robots.txt, sitemap.xml).
# Рендерится только на сервере; если не задан, используется боевой домен.
# SITE_URL=https://rbt74.ru

# --- Публичные переменные (NEXT_PUBLIC_*, вшиваются в бандл при сборке) ---
# Пока не требуются.
